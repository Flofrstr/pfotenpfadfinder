{
  "name": "pfotenpfadfinder-landingpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate:form",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --type-check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:form": "node scripts/generate-contact-form.mjs",
    "perf:js": "node scripts/measure-initial-js.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run knip",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "8.5.26",
    "postcss-load-config": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "simple-git-hooks": {
    "pre-commit": "npm exec lint-staged",
    "pre-push": "npm run check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mdx}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "simple-git-hooks@2.13.1": true,
    "unrs-resolver@1.12.2": true
  }
}
